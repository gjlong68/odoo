<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.zd.goods.in.transit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account_accountant.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='account_stock_valuation_accounts']/div[hasclass('content-group')]"
                   position="inside">
                <div class="row mt8">
                    <label for="stock_transit_account_id"
                           class="col-lg-5 o_light_label"
                           string="Goods in Transit Account"/>
                    <field name="stock_transit_account_id"
                           decoration-muted="not stock_transit_account_active"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
